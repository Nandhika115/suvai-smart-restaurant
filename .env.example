# Used to sign session cookies. Set any long random string in production.
SESSION_SECRET=change-this-to-a-long-random-string

# Optional — only needed if you wire up real Google OAuth (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional — only needed for the Platinum-level AI recommendations to use
# a real LLM instead of the built-in heuristic. Get a free key at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEy=
